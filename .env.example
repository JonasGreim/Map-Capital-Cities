# Copy to .env (never commit it)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/capitals
PORT=3001
RESTCOUNTRIES_API_KEY=
VITE_MAPBOX_TOKEN=
# Optional public API base URL for a separately hosted static frontend; rebuild after changes.
# Leave empty for the Vite/Nginx same-origin proxies.
VITE_API_BASE_URL=
# Comma-separated exact frontend origins. Unset: development allows CORS,
# production denies cross-origin requests (same-origin proxies still work).
# CORS_ORIGINS=https://your-frontend.onrender.com
# Enable shared per-instance write/reset limits for an anonymous public demo.
# PUBLIC_DEMO=true

# Full-stack Compose demo (http://localhost:8080)
# VITE_MAPBOX_TOKEN is public and baked into the frontend at build time.
# RESTCOUNTRIES_API_KEY is private and needed only before the first successful DB import.
# DATABASE_URL and PORT above remain npm-development settings; Compose uses db:5432/3001.
DEMO_PORT=8080
