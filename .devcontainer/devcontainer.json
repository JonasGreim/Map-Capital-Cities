{
  "name": "capital-cities-test",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash -lc '. \"$NVM_DIR/nvm.sh\" && nvm install && nvm alias default 24.22.1 && npm install --global npm@11.19.1 && npm ci'",
  "forwardPorts": [5173, 3001, 5432],
  "portsAttributes": { "5173": { "label": "frontend", "onAutoForward": "openBrowser" } },
  "secrets": {
    "RESTCOUNTRIES_API_KEY": { "description": "restcountries.com API key" },
    "VITE_MAPBOX_TOKEN": { "description": "Mapbox public token (pk.*)" }
  }
}
