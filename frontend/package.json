{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run test:unit && npm run test:branding",
    "test:unit": "tsx --tsconfig tsconfig.test.json --test --test-reporter=spec --test-timeout=30000 test/*.test.tsx",
    "test:branding": "tsx --tsconfig tsconfig.test.json --test --test-reporter=spec --test-concurrency=1 --test-timeout=120000 test/branding.test.ts",
    "preview": "vite preview"
  },
  "dependencies": { "mapbox-gl": "^3.6.0", "react": "^18.3.1", "react-dom": "^18.3.1", "zustand": "^4.5.4" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^18.3.3", "@types/react-dom": "^18.3.0", "@vitejs/plugin-react": "^4.3.1", "tsx": "^4.19.0", "typescript": "^5.5.0", "vite": "^5.4.0" }
}
